{
  "name": "geoclass-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "key": "node scripts/new-teacher-key.mjs",
    "db:local": "wrangler d1 migrations apply geoclass --local",
    "check:migration": "node scripts/check-migration.mjs",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.5.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.0.0"
  }
}
