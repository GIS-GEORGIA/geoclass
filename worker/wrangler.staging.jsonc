{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Staging: the same Worker and app on workers.dev, with its own empty database and its own teacher key.
  // Deploy with: npx wrangler deploy -c wrangler.staging.jsonc. Nothing here touches geoclass.qgis.ge or its data.
  "name": "geoclass-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../build/web",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/areas/*"]
  },
  // Elevation packages for the terrain games (tool/areas/build_area.py), served at /areas/*.
  "r2_buckets": [{ "binding": "AREAS", "bucket_name": "geoclass-areas-staging" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "geoclass-staging",
      "database_id": "3413377a-97a5-441d-8619-c178b960b29c",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "SUBMIT_LIMIT", "namespace_id": "1002", "simple": { "limit": 600, "period": 60 } }
  ]
}
