{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "geoclass",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "observability": { "enabled": true },
  // The Flutter web build is served by the same Worker, so the app and /api share one origin.
  "assets": {
    "directory": "../build/web",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "geoclass",
      // Local placeholder. `wrangler d1 create geoclass` prints the real id before the first deploy.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // A whole class shares one IP address, so this limit is generous.
  "ratelimits": [
    { "name": "SUBMIT_LIMIT", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }
  ]
}
