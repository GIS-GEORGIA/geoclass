{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "geoclass",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "observability": { "enabled": true },
  "routes": [{ "pattern": "geoclass.qgis.ge", "custom_domain": true }],
  // The Flutter web build is served by the same Worker, so the app and /api share one origin.
  "assets": {
    "directory": "../build/web",
    // The Worker reads card pictures through this to serve them under ids that don't give away the pairs.
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "geoclass",
      "database_id": "30eca52a-877c-422f-a0a5-207d564567e1",
      "migrations_dir": "migrations"
    }
  ],
  // A whole class shares one IP address and the mapping game sends many objects, so this limit is generous.
  // Every night: sessions older than 6 months are deleted with their answers (deleteOld in src/retention.ts).
  "triggers": { "crons": ["30 2 * * *"] },
  "ratelimits": [
    { "name": "SUBMIT_LIMIT", "namespace_id": "1001", "simple": { "limit": 600, "period": 60 } }
  ]
}
